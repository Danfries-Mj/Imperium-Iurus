# =============================================================================
# IMPERIUM IURIS — Variables de entorno para DESARROLLO LOCAL
# Copia este archivo como .env.local y completa los valores autorizados.
# - NUNCA subas .env.local al repositorio.
# - Usa SOLO credenciales del proyecto Supabase de DESARROLLO.
#   Nunca uses claves, correos ni dominios de producción.
# Guía completa: docs/INSTALACION.md
# =============================================================================

# ─── SITIO ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── SUPABASE DEV (OBLIGATORIAS) ─────────────────────────────────────────────
# Las entrega el responsable del proyecto por un canal privado.
# Sin estas tres variables la aplicación no arranca.
# URL con formato https://<referencia>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SECRETA y solo de servidor: da acceso total a la base de datos DEV.
# No la compartas, no la pegues en chats ni capturas y no la uses en código cliente.
SUPABASE_SERVICE_ROLE_KEY=

# ─── CORREO (Resend) ─────────────────────────────────────────────────────────
# En desarrollo NO uses una clave real. Este marcador ficticio permite arrancar;
# los envíos fallan y la cita o consulta se guarda igualmente.
RESEND_API_KEY=re_marcador_ficticio_desarrollo
RESEND_FROM_EMAIL=onboarding@resend.dev
# Dirección de prueba de Resend; el formulario de contacto la exige.
RESEND_TO_EMAIL=delivered@resend.dev
# Solo desarrollo local (next dev): omite los correos de agenda sin llamar a Resend.
# Se ignora si NODE_ENV no es "development" (next build/start, Vercel).
# DISABLE_APPOINTMENT_EMAILS=true
# AVISO: esta protección solo es efectiva si la rama que usas ya incorpora el
# cambio correspondiente de app/api/appointments/route.ts. Sin ese cambio la
# variable no tiene efecto, aunque la descomentes.

# ─── OPCIONALES (dejar vacías en desarrollo) ─────────────────────────────────
# Alternativa a app_metadata.role = 'admin' para identificar al administrador.
ADMIN_EMAIL=

# "Recordar este dispositivo" del 2FA. Si lo necesitas, genera un valor propio:
#   openssl rand -hex 32
TRUSTED_DEVICE_SECRET=

# Notificaciones Web Push al admin. Vacías = desactivadas.
# No pongas valores de relleno: un par VAPID inválido rompe contacto, agenda y chat.
# Para probarlas: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Webhook de WhatsApp (Meta). Vacías = integración desactivada: sin
# WHATSAPP_APP_SECRET se rechazan (403) todos los mensajes entrantes.
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
